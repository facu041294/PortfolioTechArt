---
// src/components/ProjectCard.astro
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Importar todas las imágenes raster de src/assets/img/ para resolución dinámica
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/img/*.{png,jpg,jpeg}'
);

// Resolver un nombre de archivo a ImageMetadata
function resolveImage(filename: string): ImageMetadata | undefined {
  const key = Object.keys(imageModules).find(
    (k) => k.endsWith(`/${filename}`)
  );
  if (!key) return undefined;
  // import.meta.glob devuelve funciones eager=false por defecto,
  // pero en frontmatter de Astro las llamamos síncronamente via .then o acceso directo.
  // Usamos eager: true para obtener los módulos directamente.
  return undefined; // placeholder — veamos eager glob abajo
}

// Versión eager para acceso síncrono en frontmatter
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/img/*.{png,jpg,jpeg}',
  { eager: true }
);

function getImageMetadata(filename: string): ImageMetadata | undefined {
  const key = Object.keys(images).find(
    (k) => k.endsWith(`/${filename}`)
  );
  return key ? images[key]?.default : undefined;
}

interface Props {
  project: {
    id: string;
    title: string;
    descArtist: string;
    descTechnical: string;
    timeSaved?: string;
    imageSlider: string[];
    imageLabels: string[];
    snippetImg?: string;
    snippetCode?: {
      lang: string;
      code: string;
    };
    link: string;
    category?: string;
    tags?: string[];
  };
  index: number;
}

const { project, index } = Astro.props;

// Determinamos los tags y categorías predeterminadas si no existen aún en el JSON
const projectCategory = project.category || "pipeline-tools";
const projectTags = project.tags || [];

// Normalizar la ruta base asegurando que termine con barra inclinada (para SVGs y assets no optimizados)
const rawBase = String(import.meta.env.BASE_URL || '/');
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<!-- Tarjeta Compacta (Vista Grid) -->
<div 
  class="project-card-compact" 
  data-project-id={project.id}
  data-category={projectCategory}
  data-tags={projectTags.join(',')}
>
  <div class="card-image-wrapper">
    {getImageMetadata(project.imageSlider[0]) ? (
      <Picture
        src={getImageMetadata(project.imageSlider[0])!}
        alt={project.title}
        formats={['avif', 'webp']}
        loading="lazy"
        class="card-cover-image"
      />
    ) : (
      <img
        src={`${base}assets/img/${project.imageSlider[0]}`}
        alt={project.title}
        class="card-cover-image"
        loading="lazy"
      />
    )}
    <span class="card-category-tag">{projectCategory === 'pipeline-tools' ? 'Pipeline & Tools' : projectCategory === 'ai-devops' ? 'IA & DevOps' : projectCategory === '3d-art' ? 'Art & Texturing' : 'Cinematics & FX'}</span>
  </div>
  <div class="card-content">
    <h3>{project.title}</h3>
    <p class="card-desc artist-desc">{project.descArtist}</p>
    <p class="card-desc technical-desc">{project.descTechnical}</p>
    <button class="open-details-btn">Ver Detalles</button>
  </div>
</div>

<!-- Modal de Detalle Completo (Oculto por defecto) -->
<div class="project-modal-overlay" id={`modal-${project.id}`} aria-hidden="true">
  <div class="project-modal-content">
    <button class="close-modal-btn" aria-label="Cerrar detalles">&times;</button>
    
    <div class="modal-body-layout">
      <!-- Lado Izquierdo: Textos, snippets y link -->
      <div class="modal-text-side">
        <span class="modal-category-tag">{projectCategory === 'pipeline-tools' ? 'Pipeline & Tools' : projectCategory === 'ai-devops' ? 'IA & DevOps' : projectCategory === '3d-art' ? 'Art & Texturing' : 'Cinematics & FX'}</span>
        <h2>{project.title}</h2>
        
        {project.timeSaved && (
          <div class="time-saved-badge">
            <span class="badge-label">Tiempo Ahorrado:</span>
            <span class="badge-value">{project.timeSaved}</span>
          </div>
        )}

        <p class="project-desc artist-desc">{project.descArtist}</p>
        <p class="project-desc technical-desc">{project.descTechnical}</p>
        
        <a href={project.link} class="cta-button primary-cta modal-cta-link" target="_blank" rel="noopener noreferrer">
          Ver proyecto completo
        </a>
      </div>

      <!-- Lado Derecho: Slider de Imágenes interactivo -->
      <div class="modal-visual-side">
        <div class="image-slider" data-slider-id={project.id}>
          <div class="slider-images">
            {project.imageSlider.map((img, i) => {
              const imgMeta = getImageMetadata(img);
              return imgMeta ? (
                <Picture
                  src={imgMeta}
                  alt={`${project.title} - ${project.imageLabels[i]}`}
                  formats={['avif', 'webp']}
                  loading="lazy"
                  class={`slider-image ${i === 0 ? 'active' : ''} lightbox-trigger`}
                  data-layer={project.imageLabels[i]}
                />
              ) : (
                <img
                  src={`${base}assets/img/${img}`}
                  class={`slider-image ${i === 0 ? 'active' : ''} lightbox-trigger`}
                  data-layer={project.imageLabels[i]}
                  loading="lazy"
                  alt={`${project.title} - ${project.imageLabels[i]}`}
                />
              );
            })}
          </div>

          <!-- Flechas de navegación -->
          <button class="slider-arrow prev-arrow" aria-label="Imagen anterior">&lsaquo;</button>
          <button class="slider-arrow next-arrow" aria-label="Imagen siguiente">&rsaquo;</button>

          <div class="slider-controls">
            {project.imageLabels.map((label, i) => (
              <button 
                class={`slider-control-item ${i === 0 ? 'active' : ''}`} 
                data-target-layer={label}
              >
                {label}
              </button>
            ))}
          </div>
        </div>
        <p class="lightbox-hint">💡 Haz clic en la imagen para ver de cerca</p>
      </div>

      <!-- Lado Inferior (Full-width): Snippets de Código o de Blueprints -->
      {project.snippetImg && (() => {
        const snippetMeta = getImageMetadata(project.snippetImg);
        return (
          <div class="technical-snippet full-width-snippet">
            <h4>Blueprint Logic Snippet:</h4>
            {snippetMeta ? (
              <Picture
                src={snippetMeta}
                alt={`Captura técnica de ${project.title}`}
                formats={['avif', 'webp']}
                loading="lazy"
                class="lightbox-trigger"
              />
            ) : (
              <img src={`${base}assets/img/${project.snippetImg}`} alt={`Captura técnica de ${project.title}`} class="lightbox-trigger" />
            )}
          </div>
        );
      })()}

      {project.snippetCode && (
        <div class="technical-snippet full-width-snippet">
          <h4>{project.snippetCode.lang.toUpperCase()} Snippet:</h4>
          <pre><code class={`language-${project.snippetCode.lang}`}>{project.snippetCode.code}</code></pre>
        </div>
      )}
    </div>
  </div>
</div>
