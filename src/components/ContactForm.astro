---
// src/components/ContactForm.astro
---

<div class="contact-form-toggle-wrapper">
  {/* Checkbox oculto controlado por el label (disparador) */}
  <input 
    type="checkbox" 
    id="contact-toggle-checkbox" 
    class="contact-toggle-checkbox" 
    aria-controls="contact-form-container"
  />

  <div id="contact-form-container" class="contact-form-container" aria-hidden="true">
    <form action="https://formspree.io/f/xzzgbllz" method="POST" class="contact-form actual-form">
      <h4>Envíame un mensaje:</h4>
      <div class="form-group">
        <label for="form-name">Nombre:</label>
        <input type="text" id="form-name" name="name" required />
      </div>
      <div class="form-group">
        <label for="form-email">Email:</label>
        <input type="email" id="form-email" name="email" required />
      </div>
      <div class="form-group">
        <label for="form-message">Mensaje:</label>
        <textarea id="form-message" name="message" rows="5" required></textarea>
      </div>
      <button type="submit" class="cta-button secondary-cta submit-form-button">Enviar Mensaje</button>
    </form>
    <div class="thank-you-message" style="display: none;">
      <p>¡Gracias por tu mensaje! Te responderé pronto.</p>
    </div>
  </div>
</div>
